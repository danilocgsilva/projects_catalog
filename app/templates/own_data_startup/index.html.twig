{% extends 'base.html.twig' %}

{% block title %}Own data startup{% endblock %}

{% block body %}

<div class="example-wrapper">
    <h1>Own data startup</h1>
    <p>In the first time you install this application in a new environment, it is supposedly to already have an application production database somewhere else, if not connected to a database. Here you can use a sql backup to catches the previous state from your projects.</p>
    {{ form_start(form) }}
        {{ form_row(form.file) }}
        <button type="submit">Upload</button>
    {{ form_end(form) }}
</div>
{% endblock %}
